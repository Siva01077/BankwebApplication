@model LoginsModel.TransactionModel

@{
    ViewBag.Title = "Fund Transfer";
    Layout = "~/Views/Shared/_Layout_User.cshtml";
}

<div class="container mt-4">
    <h3 class="text-primary">Transfer Funds</h3>

    <form id="transferForm">
        <div class="mb-3">
            @Html.LabelFor(m => m.RecieverName, "Receiver Username")
            @Html.TextBoxFor(m => m.RecieverName, new { @class = "form-control",id= "RecieverName" ,required = "required" })
        </div>
        <div class="mb-3">
            @Html.Label("ReceiverAccount", "Receiver Account Number")
            @Html.TextBox("ReceiverAccount", "", new { @class = "form-control",id= "ReceiverAccount",  required = "required" })
        </div>
        <div class="mb-3">
            @Html.LabelFor(m => m.Debit, "Amount")
            @Html.TextBoxFor(m => m.Debit, new { @class = "form-control",id= "Debit",  required = "required" })
        </div>

        <button type="submit" class="btn btn-primary">Transfer</button>
    </form>

    <div id="msg" class="mt-3"></div>
</div>


    <script>
    $("#transferForm").submit(function (e) {
        e.preventDefault();

        var formData = {
            ReceiverName: $("#RecieverName").val(),
            ReceiverAccount: $("#ReceiverAccount").val(),
            Debit: $("#Debit").val()
        };
        $.ajax({
            url: '@Url.Action("Transfer", "UserAccountDetails")',
            type: 'POST',
            contentType: "application/json",
            data: JSON.stringify(formData),
            success: function (res) {
                if (res.success) {
                    $("#msg").html('<span class="text-success">Transfer successful!</span>');
                    setTimeout(() => window.location.href = '@Url.Action("UserDashboard", "UserAccountDetails")', 3000);
                } else {
                    $("#msg").html('<span class="text-danger">' + res.message + '</span>');
                }
            }
        });
    });
    </script>

