@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>HDFC Bank - Login</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="stylesheet" href="~/Content/bootstrap.min.css" />
    <script src="~/Scripts/jquery-3.7.1.min.js"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <!-- In _Layout_Employee.cshtml -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        /* Background gradient */
        html, body {
            height: 100%;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background-color: mistyrose;
            color: #fff;
        }

        body {
            margin: 0;
            padding: 0;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .container {
            flex: 1;
        }

        footer {
            margin-top: auto;
        }

        /* Header */
        .header {
            background-color: #0094ff;
            color: #f0f8ff;
            padding: 20px 0 10px;
            text-align: center;
            box-shadow: 0 2px 6px rgba(0,0,0,0.3);
        }

            .header .title-row {
                display: flex;
                justify-content: center;
                align-items: center;
                gap: 20px;
            }

            .header img {
                height: 60px;
                filter: drop-shadow(1px 1px 2px rgba(0,0,0,0.5));
            }

            .header h1 {
                font-size: 2.4rem;
                margin: 0;
                font-weight: 700;
                letter-spacing: 1.5px;
                text-shadow: 1px 1px 3px rgba(0,0,0,0.7);
            }

        /* Footer */
        .footer {
            background-color: #002244;
            color: #a0c8ff;
            text-align: center;
            padding: 12px 0;
            font-size: 0.9rem;
            box-shadow: inset 0 1px 3px rgba(255,255,255,0.1);
            user-select: none;
        }

        /* Welcome Text */
        .welcome-text {
            color: #ffd800;
            font-weight: 700;
            font-size: 2rem;
            text-align: center;
            margin-bottom: 30px;
        }

        /* Main container with notifications + login */
        .main-row {
            width: 100%;
            max-width: 1000px;
            display: flex;
            justify-content: center;
            gap: 40px;
            padding: 0 15px;
        }


        /* Form labels */
        label {
            font-weight: 600;
            color: #004080;
        }

        /* Form controls */
        .form-control {
            border: 2px solid #3399ff;
            border-radius: 10px;
            padding: 10px 14px;
            font-size: 1.05rem;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

            .form-control:focus {
                border-color: #007bff;
                box-shadow: 0 0 8px rgba(0, 123, 255, 0.5);
                outline: none;
            }

        /* Validation message styling */
        .text-danger {
            font-size: 0.9rem;
            margin-top: 5px;
            display: block;
        }

        /* Center login button */
        .btn-center {
            text-align: center;
            margin-top: 30px;
        }

        .btn-success {
            background-color: #007bff;
            border: none;
            padding: 12px 36px;
            font-size: 1.2rem;
            font-weight: 700;
            border-radius: 12px;
            transition: background-color 0.3s ease;
            box-shadow: 0 5px 15px rgba(0, 123, 255, 0.5);
            cursor: pointer;
        }

            .btn-success:hover {
                background-color: #0056b3;
                box-shadow: 0 8px 20px rgba(0, 86, 179, 0.6);
            }

        /* Responsive tweaks */
        @@media (max-width: 768px) {
            .main-row {
                flex-direction: column;
                align-items: center;
                gap: 30px;
            }

            .notification-box {
                width: 90%;
            }
        }
    </style>
</head>
<body>
    <!-- Header -->
    <div class="header">
        <div class="container">
            <div class="title-row">
                <img src="~/Images/hdfclogo.jpg" alt="HDFC Bank" class="img-fluid" />
                <h1>HDFC BANK</h1>
            </div>
        </div>
    </div>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <!-- Brand -->
            <a class="navbar-brand d-flex align-items-center" href="#">
                <i class="fas fa-university me-2"></i> HDFC Bank
            </a>

            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarUser"
                    aria-controls="navbarUser" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarUser">
                <!-- Left Nav -->
                <ul class="navbar-nav">
                    <li class="nav-item"><a class="nav-link" href="/EmployeeDetails/Dashboard"><i class="fas fa-home"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/EmployeeDetails/Applications"> <i class="fas fa-file-alt"></i> Applications </a> </li>
                    <li class="nav-item"><a class="nav-link" href="/EmployeeDetails/Transactions"><i class="fas fa-list"></i> Transactions</a></li>

                </ul>

                <!-- Logout on Right -->
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link text-danger" href="/EmployeeDetails/Employeelogout"><i class="fas fa-sign-out-alt"></i> Logout</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Page Content -->
    <div class="container mb-3 flex-grow-1">
        @RenderBody()
    </div>

    <!-- Footer -->
    <div class="footer">
        &copy; @DateTime.Now.Year HDFC Bank. All Rights Reserved.
    </div>
</body>

</html>
