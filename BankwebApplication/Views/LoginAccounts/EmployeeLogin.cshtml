@model LoginsModel.EmployeeLoginDTO

@{
    Layout = "~/Views/Shared/_Layout_Login.cshtml";
}

<script>
    $(document).ready(function () {
        $('#form').on('submit', function (e) {
            let username = $('#Username').val().trim();
            let password = $('#Password').val().trim();

            if (!username || !password) {
                e.preventDefault();
                if (!username) {
                    alert("Please enter username");
                }
                if (!password) {
                    alert("Please enter password");
                }
            }
        });
    });
</script>
<h4 align="center">Employee Login</h4>
<br />
<br />

@using (Html.BeginForm("EmployeeLogin", "LoginAccounts", FormMethod.Post, new { id = "form" }))
{
    <div class="row mb-3">
        <div class="col-lg-3">
            @Html.LabelFor(m => m.Username)
        </div>
        <div class="col-lg-7">
            @Html.TextBoxFor(m => m.Username, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger" })
        </div>
    </div>

    <div class=" row mb-3">
        <div class="col-lg-3">
            @Html.LabelFor(m => m.Password)
        </div>
        <div class="col-lg-7">
            @Html.PasswordFor(m => m.Password, new { @class = "form-control" })
            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
        </div>
    </div>
    <div class="text-center mt-4">
        <button type="submit" class="btn btn-success px-4">Login</button>
    </div>
    <div style="color:red">@ViewBag.Msg</div>

}





